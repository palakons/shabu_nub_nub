# Application Runtime Configuration
NODE_ENV=production
HOST=127.0.0.1
PORT=3002

# Canonical Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://app_user:secure_password@127.0.0.1:5432/shabu_db

# Database Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# Security & CORS (Optional)
CORS_ORIGIN=https://shabu.longwarp.com
